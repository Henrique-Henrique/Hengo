clear_button_enabled = true

[node name="RefreshBt" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
tooltip_text = "Refresh instance list"
text = "Refresh"
flat = true

[node name="Hint" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "No live instances. Press Play and use Refresh after the scene loads."
